{
  "name": "memberberry-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:sw && npm run build:clipper",
    "build:sw": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/build-sw.ts",
    "build:clipper": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/build-clipper.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "e2e": "playwright test",
    "perf": "node --disable-warning=ExperimentalWarning --experimental-strip-types perf/run.ts",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^3.0.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@mozilla/readability": "^0.5.0",
    "@tiptap/core": "^3.30.6",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svelte": "^5.57.0",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  }
}
